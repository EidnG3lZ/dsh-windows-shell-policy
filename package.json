{
  "name": "dsh-windows-shell-policy",
  "version": "0.1.1",
  "description": "DSH Windows shell policy plugin: manage multiple shell tools (git-bash / MSYS2 / Cygwin / PowerShell) as add-and-remove entries with an enable switch, auto-detected path, tool prompt and full-sandbox permission. DSH Windows Shell 策略插件：以可增删条目管理多个 shell 工具（启用开关 / 路径自动探测 / 工具提示词 / 沙箱完全权限）并动态注册对应工具",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shell",
    "bash",
    "git-bash",
    "windows",
    "pwsh",
    "powershell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LAN-TINA-WS/dsh-windows-shell-policy.git"
  },
  "homepage": "https://github.com/LAN-TINA-WS/dsh-windows-shell-policy#readme",
  "bugs": {
    "url": "https://github.com/LAN-TINA-WS/dsh-windows-shell-policy/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-sandbox": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-jobs": ">=0.0.1-rc <2",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:host": "node tests/host-harness.mjs",
    "test:exec": "node tests/executable-and-args.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
